# Copy this file to .env for local development and fill in values as needed.
# In production (Render), these are set as real environment variables instead
# of a .env file — see render.yaml.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
FRONTEND_URL=http://localhost:3000

# Optional: real SMTP delivery for password-reset emails.
# Left unset, emails are printed to the console instead of sent.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Optional: enables the AI assistant features (falls back to rule-based
# responses when unset).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: persists uploaded complaint photos/avatars to Cloudinary instead
# of local disk. Required in production on hosts with an ephemeral filesystem
# (e.g. Render's free tier) — without this, uploaded images are lost on every
# restart/redeploy.
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
